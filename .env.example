# Backend & Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/foodwaste_db
# For zero-dependency local SQLite development without Docker, use:
# DATABASE_URL=sqlite:///./food_waste.db

SECRET_KEY=mvp-super-secret-key-change-in-production-hotel-banquet-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Credentials
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo123
DEMO_HOTEL_NAME=Dolphin Hotels

# AI Computer Vision Configuration
# AI_MODE options: "mock" (default, zero GPU/weights needed for instant demo) or "yolo" (YOLO26-seg PyTorch/Ultralytics)
AI_MODE=mock
AI_MODEL_PATH=ai/weights/yolo26-seg.pt
AI_CONFIDENCE_THRESHOLD=0.70
AI_MODEL_NAME=YOLO26-seg
AI_MODEL_VERSION=food-model-v0.1

# Storage Configuration
# STORAGE_PROVIDER options: "local" (default) or "s3"
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
